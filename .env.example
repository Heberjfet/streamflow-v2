# ──────────────────────────────────
# StreamFlow — Environment Variables
# ──────────────────────────────────

# Database
DATABASE_URL=postgresql://streamflow:streamflow@localhost:5432/streamflow

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-this-in-production

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=streamflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# For public URLs (used in API responses for playback/thumbnails)
# In production: https://minio.dominio.com
S3_PUBLIC_URL=http://localhost:9000
S3_BROWSER_ENDPOINT=http://localhost:9000

# CORS — Comma-separated list of allowed origins
# In production: https://dominio.com,https://app.dominio.com
# Leave empty or set to * to allow all origins (not recommended for production)
CORS_ORIGINS=*

# API
PORT=3001

# Frontend
# In development: http://localhost:3001
# With nginx proxy: /api (relative, same-origin)
NEXT_PUBLIC_API_URL=http://localhost:3001

# S3 public URL for frontend thumbnails
# In production: https://minio.dominio.com
NEXT_PUBLIC_S3_URL=http://localhost:9000

# SSL (for nginx in production)
# SSL_CERT_DIR=./ssl
