# ──────────────────────────────────
# StreamFlow — Variables de Entorno
# ──────────────────────────────────

# Database
DATABASE_URL=postgresql://streamflow:streamflow@postgres:5432/streamflow

# Redis
REDIS_URL=redis://redis:6379

# JWT — CAMBIAR en producción
JWT_SECRET=change-this-in-production

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_BUCKET=streamflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# URLs públicas de S3 (para respuestas del API: playback, thumbnails)
# En producción: http://IP_DEL_VPS:9000 o un subdominio como https://minio.cloudjfet.site
S3_PUBLIC_URL=http://2.24.200.150:9000
S3_BROWSER_ENDPOINT=http://2.24.200.150:9000

# CORS — orígenes permitidos (separados por coma)
# Con nginx + mismo dominio no hace falta, pero por las dudas:
CORS_ORIGINS=http://flow.cloudjfet.site,https://flow.cloudjfet.site

# API
PORT=3001

# Frontend — con nginx proxy usamos ruta relativa (mismo dominio)
NEXT_PUBLIC_API_URL=/api

# URL pública de S3 para thumbnails desde el frontend
NEXT_PUBLIC_S3_URL=http://2.24.200.150:9000
