# ──────────────────────────────────
# StreamFlow — Variables de Entorno
# ──────────────────────────────────

# Database
DATABASE_URL=postgresql://streamflow:streamflow@postgres:5432/streamflow

# Redis
REDIS_URL=redis://redis:6379

# JWT — CAMBIAR en producción
JWT_SECRET=change-this-in-production

# S3 / MinIO — interno (Docker network)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=streamflow
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# URLs públicas de S3 — proxyadas por nginx para evitar mixed content
# Con Cloudflare: https://flow.cloudjfet.site/s3
S3_PUBLIC_URL=https://flow.cloudjfet.site/s3
S3_BROWSER_ENDPOINT=https://flow.cloudjfet.site/s3

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS=https://flow.cloudjfet.site,http://flow.cloudjfet.site

# API
PORT=3001

# Frontend — ruta relativa (mismo dominio vía nginx)
NEXT_PUBLIC_API_URL=/api

# URL pública de S3 para thumbnails desde el frontend
# Con Cloudflare: https://flow.cloudjfet.site/s3
NEXT_PUBLIC_S3_URL=https://flow.cloudjfet.site/s3
